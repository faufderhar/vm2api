# copy to .env  (chmod 600). Used by docker compose and local node.
# VM2API_* wins; KIN_* is fallback.
#
# 未配置时一键脚本只填空字段。容器入口会把生成的管理台密码和 API key
# 写到数据目录旁边的 secrets/，重启和重建都继续用这一份，不再每次换新的。
# 密码为空或仍是 123456 时才生成，写在 secrets/admin.password，不打印到容器日志。
# 数据库密钥只放 secrets/db.secret，入口不再往环境变量里塞一把新密钥。
# 部署在反代（nginx / Caddy）后面必须设 TRUST_PROXY=1。
# 不设时登录限流按连接对端计数，所有人的登录都算在反代这一个地址上，
# 任何人输错密码都能把所有人锁在登录页外。
# 设了之后才会采用 X-Forwarded-For 的最后一跳，登录 Cookie 才会相信 X-Forwarded-Proto。
# TRUST_PROXY=1

VM2API_API_KEY=
VM2API_ADMIN_USER=admin
VM2API_ADMIN_PASSWORD=
VM2API_DB_SECRET=

PORT=8787
HOST=0.0.0.0
# HOST 仅监听；/health、/v1/meta 的 base_url 需配置 PUBLIC_BASE_URL 或 PUBLIC_HOST（勿把 0.0.0.0 当对外地址）
# PUBLIC_BASE_URL=https://example.com
# PUBLIC_HOST=127.0.0.1
# 面板会话不是 API key：默认不能调 /v1 推理（不计费、不限额会绕过配额）。
# 设为 admin 时只放行 admin 会话（等同 master 的平台级用量，仍不计费）；租户与 super 始终需要 API key。
# VM2API_PANEL_SESSION_INFERENCE=admin
# 终端 WebSocket（槽终端、集群节点终端）心跳间隔，毫秒；错过一次 pong 即断开半开连接。0 关闭心跳。
# VM2API_WS_HEARTBEAT_MS=30000
# Responses WebSocket 打开连接上限：每个客户端地址 / 每个托管 API key；0 不限。回环来源（本机反代且未设 TRUST_PROXY）只按 key 限制。
# VM2API_RESPONSES_WS_MAX_PER_IP=128
# VM2API_RESPONSES_WS_MAX_PER_KEY=64
# GITHUB_TOKEN=          # 可选。面板查 GitHub Release 提高限额；也可用 VM2API_GITHUB_TOKEN

# 部署来源（供应链）。默认跟随上游 dofastted/vm2api；fork 自己发版时改成自己的仓库和镜像。
# VM2API_GITHUB_REPO 同时影响 deploy/install.sh 和面板「检查更新 / 一键更新」。
# 也决定源码/镜像构建时 scripts/fetch-payload.mjs 下载 payload 的仓库（sha256 仍按 deploy/payload.json 校验）。
# install.sh upgrade 会从已安装目录的 .env 读取它，不必 sudo 传环境变量；fork 安装时若未设 VM2API_IMAGE，
# 会写入 ghcr.io/<fork 仓库小写>。
# VM2API_GITHUB_REPO=dofastted/vm2api
# VM2API_IMAGE=ghcr.io/dofastted/vm2api
# VM2API_IMAGE_TAG=v1.3.226   # 固定版本；不设时 docker-compose.yml 用 latest
# docker compose 监听地址。HOST 由 compose 固定传入容器，改监听请用这个变量；
# 有 TLS 反代时设 127.0.0.1，避免明文 8787 暴露到公网。
# VM2API_BIND_HOST=127.0.0.1
